class Solution {
    public ListNode middleNode(ListNode head) {
        ListNode slow = head;
        ListNode fast = head;
        
        while (fast != null && fast.next != null) {
            slow = slow.next;       // move one step
            fast = fast.next.next;  // move two steps
        }
        
        return slow; // slow is at the middle
    }
}
